{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "font-bitmap",
  "main": "src/entry.py",
  // Python 3.14 requires 2026-09-08 or later; python_workers flag is required.
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS"
  }
}
